#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int knapsack(int N, int val[], int wt[], int W) {
    int dp[N + 1][W + 1];

    for (int i = 0; i <= N; i++) {
        for (int j = 0; j <= W; j++) {
            if (i == 0 || j == 0)
                dp[i][j] = 0;
            else if (wt[i - 1] <= j)
                dp[i][j] = max(val[i - 1] + dp[i - 1][j - wt[i - 1]],
                               dp[i - 1][j]);
            else
                dp[i][j] = dp[i - 1][j];
        }
    }
    return dp[N][W];
}

int main() {
    int N;
    scanf("%d", &N);

    int val[N], wt[N];
    for (int i = 0; i < N; i++)
        scanf("%d", &val[i]);
    for (int i = 0; i < N; i++)
        scanf("%d", &wt[i]);

    int W;
    scanf("%d", &W);

    printf("%d\n", knapsack(N, val, wt, W));
    return 0;
}

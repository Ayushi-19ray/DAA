#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF INT_MAX

int find(int parent[], int i) {
    if (parent[i] == i)
        return i;
    parent[i] = find(parent, parent[i]);
    return parent[i];
}

void unionSet(int parent[], int rank[], int i, int j) {
    int iroot = find(parent, i);
    int jroot = find(parent, j);
    if (iroot != jroot) {
        if (rank[iroot] < rank[jroot])
            parent[iroot] = jroot;
        else if (rank[iroot] > rank[jroot])
            parent[jroot] = iroot;
        else {
            parent[jroot] = iroot;
            rank[iroot]++;
        }
    }
}

void kruskalMST(int **cost, int V) {
    int parent[V], rank[V];
    for (int i = 0; i < V; i++) {
        parent[i] = i;
        rank[i] = 0;
    }

    int edgesCount = 0;
    int totalCost = 0;
    int edges[V * V][3];
    int edgeIndex = 0;

    // Storing all edges
    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 999 && i != j) {
                edges[edgeIndex][0] = i;
                edges[edgeIndex][1] = j;
                edges[edgeIndex][2] = cost[i][j];
                edgeIndex++;
            }
        }
    }

    // Sorting edges by weight (simple bubble sort)
    for (int i = 0; i < edgeIndex - 1; i++) {
        for (int j = i + 1; j < edgeIndex; j++) {
            if (edges[i][2] > edges[j][2]) {
                int temp0 = edges[i][0];
                int temp1 = edges[i][1];
                int temp2 = edges[i][2];

                edges[i][0] = edges[j][0];
                edges[i][1] = edges[j][1];
                edges[i][2] = edges[j][2];

                edges[j][0] = temp0;
                edges[j][1] = temp1;
                edges[j][2] = temp2;
            }
        }
    }

    // Building MST
    for (int i = 0; i < edgeIndex && edgesCount < V - 1; i++) {
        int u = edges[i][0];
        int v = edges[i][1];
        int set_u = find(parent, u);
        int set_v = find(parent, v);

        if (set_u != set_v) {
            printf("Edge: (%d, %d) cost: %d\n", u, v, edges[i][2]);
            totalCost += edges[i][2];
            unionSet(parent, rank, set_u, set_v);
            edgesCount++;
        }
    }

    printf("Minimum cost = %d\n", totalCost);
}

int main() {
    int V;
    printf("Enter number of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Enter adjacency matrix (use 999 for no edge):\n");
    for (int i = 0; i < V; i++) {
        for (int j = 0; j < V; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
